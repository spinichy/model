library(gam)
library(ggplot2)
library(dplyr)
df_smooth <- model_spline_smooth$df
gam_age <- gam(formula = wage ~ s(age, df = model_spline_smooth$df), data = wage)
baseline_sse <- gam_age$deviance
df_smooth <- model_spline_smooth$df

cat_vars <- c("maritl", "race", "education", "jobclass", "health", "health_ins")

sse_results <- data.frame(Variable = character(), SSE = numeric(), stringsAsFactors = FALSE)
for (var in cat_vars) {
  form <- as.formula(paste("wage ~ s(age, df =", df_smooth, ") +", var))
  model <- gam(form, data = wage)
  sse_results <- rbind(sse_results, data.frame(Variable = var, SSE = model$deviance))
}


sse_results <- sse_results %>% arrange(SSE)

ggplot(sse_results, aes(x = reorder(Variable, SSE), y = SSE, fill = SSE)) +
  geom_bar(stat = "identity", show.legend = FALSE) +
  geom_hline(yintercept = baseline_sse, color = "red", linetype = "dashed", size = 1) +
  annotate("text", x = 1, y = baseline_sse, label = "Age Only Model", 
           vjust = -1, color = "red", fontface = "bold") +
  geom_text(aes(label = format(round(SSE, 0), big.mark = ",")), 
            vjust = -0.5, size = 3.5, fontface = "bold") +
  scale_fill_gradient(low = "#004d00", high = "#ccffcc") +
  coord_cartesian(ylim = c(min(sse_results$SSE) * 0.95, max(baseline_sse) * 1.05)) +
  labs(title = "SSE Reduction by Adding Categorical Variables",
       subtitle = "Red dashed line represents the model with 'age' only",
       x = "Categorical Variables Added to s(age)",
       y = "Residual Deviance (SSE)") +
  theme_minimal() +
  theme(
    axis.text.x = element_text(angle = 0, face = "italic", size = 11),
    panel.grid.major.x = element_blank()
  )


m1 <- gam(wage ~ s(age, df = df_smooth), data = wage)
