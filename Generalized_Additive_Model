library(ggplot2)

spans <- seq(0.1, 0.8, by = 0.1)
results <- data.frame(Span = numeric(), Adj_R2 = numeric())
n <- nrow(wage)
SST <- sum((wage$wage - mean(wage$wage))^2)

for (s in spans) {
  model <- loess(wage ~ age, span = s, data = wage)
  SSE <- sum((wage$wage - fitted(model))^2)
 
  df_model <- model$enp
  adj_r2 <- 1 - (SSE / (n - df_model - 1)) / (SST / (n - 1))
  
  results <- rbind(results, data.frame(Span = s, Adj_R2 = adj_r2))
}

windows() 
ggplot(results, aes(x = Span, y = Adj_R2)) +
  geom_line(color = "#006d2c", size = 1.2) +
  geom_point(color = "#006d2c", size = 3) +
  geom_text(aes(label = round(Adj_R2, 5), 
                color = ifelse(Span == 0.1, "red", "black")), 
            vjust = -1.5, 
            size = 4.5, 
            fontface = "bold") +
  scale_color_identity() +
  scale_x_continuous(
    breaks = spans,
    expand = c(0.02, 0)
  ) +
  scale_y_continuous(
    limits = c(0.08, 0.10), 
    breaks = seq(0.08, 0.10, by = 0.005),
    expand = c(0, 0) 
  ) +
  labs(
    title = "LOESS Performance: Span 0.1 to 0.8",
    subtitle = "Span 0.1 (Smallest Neighbor) is Optimal",
    x = "Span (Proportion of Neighbors)",
    y = "Adjusted R-squared"
  ) +
  theme_minimal() +
  theme(
    plot.title = element_text(face = "bold", size = 14),
    panel.grid.minor = element_blank(),
    panel.grid.major = element_line(color = "grey95"),
    plot.margin = margin(35, 15, 10, 10) 
