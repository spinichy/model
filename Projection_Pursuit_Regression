model_ppr_final <- ppr(formula = perm ~ area + peri + shape, 
                       data = Rock, 
                       nterms = 2, 
                       max.terms = 2,
                       sm.method = "supsmu")
model_lm <- lm(perm ~ area + peri + shape, data = Rock)


n <- nrow(Rock)
errors_ppr <- numeric(n)
errors_lm <- numeric(n)

for (i in 1:n) {
  train_data <- Rock[-i, ]
  valid_data <- Rock[i, , drop = FALSE]
  fit_ppr <- ppr(perm ~ area + peri + shape, 
                 data = train_data, 
                 nterms = 2, 
                 max.terms = 2, 
                 sm.method = "supsmu")
  fit_lm <- lm(perm ~ area + peri + shape, data = train_data)
  pred_ppr <- predict(fit_ppr, newdata = valid_data)
  pred_lm <- predict(fit_lm, newdata = valid_data)
  
  errors_ppr[i] <- (valid_data$perm - pred_ppr)^2
  errors_lm[i] <- (valid_data$perm - pred_lm)^2
}

col_mint <- "#00BFC4"
col_pink <- "#F8766D"


par(mfrow = c(1, 2))

boxplot(errors_ppr, errors_lm, 
        names = c("PPR (2 Terms)", "Linear Model"),
        col = c(col_mint, col_pink),
        main = "Distribution of Prediction Errors",
        ylab = "Squared Error",
        border = "gray30")

mspe_values <- c(mean(errors_ppr), mean(errors_lm))
b_plot <- barplot(mspe_values, 
                  names.arg = c("PPR", "LM"), 
                  col = c(col_mint, col_pink),
                  main = "Average Prediction Error (MSPE)",
                  ylab = "Mean Squared Error",
                  ylim = c(0, max(mspe_values) * 1.2))

text(x = b_plot, y = mspe_values, label = round(mspe_values, 2), 
     pos = 3, cex = 1.1, font = 2)
