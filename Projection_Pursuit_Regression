##Step1. Data collection


library(MASS)
data(rock)
Rock <- rock


##Step2. Data preparation and exploration


str(Rock)
summary(Rock)

Rock$shape
Rock$peri/sqrt(Rock$area)

library(GGally)
ggpairs(Rock)


Rock$area <- Rock$area/10000
Rock$peri <- Rock$peri/10000
Rock$perm <- log(Rock$perm)


##Step3.Train Model


attach(Rock)
model_lm <- lm(perm ~ area + peri + shape, data = Rock)


##Step4.Evaluate Model


summary(model_lm)

R <- cor(Rock)[1:3,1:3]
eigen(R)$values
diag(solve(R))


##Step5.Improve Model


model_ppr <- ppr(formula = perm ~ area + peri + shape, 
                 data = Rock, 
                 nterms = 2, 
                 max.terms = 5,
                 sm.method = "supsmu")
summary(model_ppr)


#Visualization - GOF
par(mfrow = c(1, 3))
sm_methods <- c("supsmu", "spline", "gcvspline")
max_n <- 10

for (method in sm_methods) {
  gof_results <- numeric(max_n)
  
  for (i in 1:max_n) {
    temp_model <- ppr(perm ~ area + peri + shape, 
                      data = Rock, 
                      nterms = i, 
                      max.terms = 10, 
                      sm.method = method)
    gof_results[i] <- temp_model$gof
  }
  plot(1:max_n, gof_results, type = "b", 
       pch = 19, col = "steelblue", lwd = 2,
       xlab = "Number of Terms", 
       ylab = "GOF (RSS)",
       main = paste("Method:", method),
       xaxt = "n") 
  
  axis(1, at = 1:10)
  
  grid()
}


#Visualization - LOO
n <- nrow(Rock)
max_terms <- 5
sm_methods <- c("supsmu", "spline", "gcvspline")

par(mfrow = c(1, 3))

for (method in sm_methods) {
  loocv_errors <- matrix(0, nrow = n, ncol = max_terms)
  
  for (i in 1:n) {
    train_data <- Rock[-i, ]
    valid_data <- Rock[i, , drop = FALSE]
    
    for (k in 1:max_terms) {
      fit_k <- ppr(perm ~ area + peri + shape, 
                   data = train_data, 
                   nterms = k, 
                   max.terms = 5, 
                   sm.method = method)
      
      pred_k <- predict(fit_k, newdata = valid_data)
      loocv_errors[i, k] <- (valid_data$perm - pred_k)^2
    }
  }
  
  mspe_results <- colMeans(loocv_errors)
  
  plot(1:max_terms, mspe_results, type = "b", pch = 19, col = "darkgreen",
       xlab = "Number of Terms", 
       ylab = "MSPE (Prediction Error)",
       main = paste("LOOCV:", method),
       xaxt = "n")
  axis(1, at = 1:5)
  grid()
}


