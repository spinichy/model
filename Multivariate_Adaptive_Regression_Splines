library(ggplot2)
library(dplyr)
library(tidyr)

# 1. Prepare the data frame
results_df <- data.frame(
  Sex = factor(c("Infant", "Female", "Male"), levels = c("Infant", "Female", "Male")),
  Original = c(rmse_infant, rmse_female, rmse_male),
  Tuned = c(rmse_tuned_infant, rmse_tuned_female, rmse_tuned_male),
  Params = c("n:13, d:2", "n:8, d:1", "n:8, d:1")
)

# 2. Reshape to long format
results_long <- results_df %>%
  pivot_longer(cols = c("Original", "Tuned"), 
               names_to = "Model", 
               values_to = "RMSE") %>%
  group_by(Sex) %>%
  mutate(IsBetter = RMSE == min(RMSE)) %>%
  ungroup() %>%
  mutate(DisplayLabel = ifelse(Model == "Tuned", Params, ""))

# 3. Create the visualization
ggplot(results_long, aes(x = Sex, y = RMSE, fill = Model)) +
  geom_bar(stat = "identity", position = "dodge", alpha = 0.8) +
  
  # "better" label: Placed strictly above the bar with the lower RMSE
  # vjust is set to a negative value to push the text above the top of the bar
  geom_text(aes(label = ifelse(IsBetter, "better", "")),
            position = position_dodge(0.9), vjust = -1.5, size = 4.5, fontface = "bold") +
  
  # RMSE value: Placed in the center of the bar
  geom_text(aes(label = round(RMSE, 3)),
            position = position_dodge(0.9), vjust = 1.5, color = "white", size = 3.5) +
  
  # Hyperparameters: Placed near the bottom of the Tuned bar
  geom_text(aes(label = DisplayLabel),
            position = position_dodge(0.9), vjust = 4.0, color = "black", size = 3, fontface = "italic") +
  
  labs(title = "RMSE Comparison: Original vs Tuned MARS",
       subtitle = "text inside Tuned bars shows (nprune, degree)",
       x = "Gender",
       y = "RMSE (Lower is Better)") +
  theme_minimal(base_size = 10) +
  scale_fill_manual(values = c("Original" = "#56B4E9", "Tuned" = "#D55E00"))




library(car)
library(ggplot2)
library(dplyr)

# 1. Calculate VIF
# Ensure that Abalone[,-1] only contains numeric predictors to avoid errors
vif_model <- lm(Rings ~ ., data = Abalone[, -1])
vif_values <- vif(vif_model)

# 2. Create a data frame for ggplot
vif_df <- data.frame(
  Variable = names(vif_values),
  VIF = as.numeric(vif_values)
)

# 3. Create the visualization
ggplot(vif_df, aes(x = reorder(Variable, VIF), y = VIF)) +
  geom_col(fill = "steelblue", alpha = 0.8) +
  # Add a horizontal line at VIF = 10 (the standard threshold)
  geom_hline(yintercept = 10, color = "red", linetype = "dashed", size = 1) +
  # Add labels for clarity
  coord_flip() +
  labs(title = "VIF Values for Abalone Variables",
       subtitle = "Threshold of 10 indicates high multicollinearity",
       x = "Variables",
       y = "Variance Inflation Factor (VIF)") +
  theme_minimal(base_size = 10) +
  theme(plot.title = element_text(face = "bold"))

