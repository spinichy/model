## Step.1 Data collection


#Loading raw data


library(earth)
library(mlbench)

url <- "https://archive.ics.uci.edu/ml/machine-learning-databases/abalone/abalone.data"
column_names <- c("Sex", "Length", "Diameter", "Height", "WholeWeight", 
                  "ShuckedWeight", "VisceraWeight", "ShellWeight", "Rings")

Abalone <- read.csv(url, header = FALSE, col.names = column_names)



## Step.2 Data preparation




str(Abalone)


#visualization

library(GGally)
library(ggplot2)

Abalone$Sex <- factor(Abalone$Sex, levels = c("I", "F", "M"))

ggpairs(Abalone, 
        columns = 2:9, 
        aes(color = Sex, alpha = 0.5),
        title = "Abalone Dataset",
        upper = list(continuous = wrap("cor", size = 3)),
        lower = list(continuous = wrap("points", size = 0.5)))  



#split into train and test data



Abalone_infant <- Abalone %>% filter(Sex == "I") %>% select(-Sex)
Abalone_Female <- Abalone %>% filter(Sex == "F") %>% select(-Sex)
Abalone_Male   <- Abalone %>% filter(Sex == "M") %>% select(-Sex)

split_data <- function(data) {
  set.seed(20266010)
  train_index <- createDataPartition(data$Rings, p = 0.7, list = FALSE)
  list(train = data[train_index, ], test = data[-train_index, ])
}

data_infant <- split_data(Abalone_infant)
data_female <- split_data(Abalone_Female)
data_male   <- split_data(Abalone_Male)



## Step3. Train model


mars_infant <- earth(Rings ~ ., #forwad
                     data = data_infant$train, 
                     degree = 2, #degree = 2: Interaction Model, degree = 1: Additive Model
                     pmethod = "backward")  #Pruning Method: backward

mars_female <- earth(Rings ~ ., 
                     data = data_female$train, 
                     degree = 2, 
                     pmethod = "backward")
mars_male   <- earth(Rings ~ .,
                     data = data_male$train, 
                     degree = 2, 
                     pmethod = "backward")



##Step4.Evaluate Model



predictions_infant <- predict(mars_infant, 
                              newdata = data_infant$test)

predictions_female <- predict(mars_female, 
                              newdata = data_female$test)
predictions_male <- predict(mars_male, 
                            newdata = data_male$test)

residual_infant <- (data_infant$test$Rings - predictions_infant)
residual_female <- (data_female$test$Rings - predictions_female)
residual_male <- (data_male$test$Rings - predictions_male)

rmse_infant <- sqrt(mean(residual_infant^2))
rmse_female <- sqrt(mean(residual_female^2))
rmse_male <- sqrt(mean(residual_male^2))

cat("RMSE Infant:", rmse_infant, "\n")
cat("RMSE Female:", rmse_female, "\n")
cat("RMSE Male:", rmse_male, "\n")



residuals_df <- data.frame(
  Value = c(residual_infant, residual_female, residual_male),
  Sex = rep(c("Infant", "Female", "Male"), 
            times = c(length(residual_infant), length(residual_female), length(residual_male)))
)

#Ensure factor levels are set to the desired order
residuals_df$Sex <- factor(residuals_df$Sex, levels = c("Infant", "Female", "Male"))


library(ggplot2)
library(dplyr)

# 1alculate stats_data 
stats_data <- residuals_df %>%
  group_by(Sex) %>%
  summarise(
    rmse_val = sqrt(mean(Value^2)),
    pct_within = mean(Value >= -sqrt(mean(Value^2)) & Value <= sqrt(mean(Value^2))) * 100
  )

# Plotting
ggplot(residuals_df, aes(x = Value)) +
  geom_histogram(aes(y = after_stat(density)), bins = 30, fill = "skyblue", color = "white") +
  
  # Separate data source for vline and text to ensure variables are found
  geom_vline(data = stats_data, aes(xintercept = rmse_val), color = "red", linetype = "dashed", linewidth = 1) +
  geom_vline(data = stats_data, aes(xintercept = -rmse_val), color = "red", linetype = "dashed", linewidth = 1) +
  
  # Annotate percentage
  geom_text(data = stats_data, aes(x = 0, y = Inf, label = paste0(round(pct_within, 1), "%")), 
            vjust = 2, size = 5, fontface = "bold") +
  
  # Annotate RMSE values
  geom_text(data = stats_data, aes(x = rmse_val, y = 0, label = round(rmse_val, 3)), 
            color = "red", vjust = -1, hjust = -0.1, size = 5, fontface = "bold") +
  geom_text(data = stats_data, aes(x = -rmse_val, y = 0, label = round(-rmse_val, 3)), 
            color = "red", vjust = -1, hjust = 1.1, size = 5, fontface = "bold") +
  
  facet_wrap(~Sex, nrow = 1) +
  labs(title = "Residual Distribution & Coverage within ±RMSE",
       x = "Residuals (Observed - Predicted)",
       y = "Density") +
  theme_minimal(base_size = 10) +
  theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 10),
        strip.text = element_text(size = 13, face = "bold"))


table(Abalone$Sex)


# Create a combined data frame containing observed and predicted values
plot_data <- rbind(
  data.frame(Observed = data_infant$test$Rings, Predicted = as.vector(predictions_infant), Sex = "Infant"),
  data.frame(Observed = data_female$test$Rings, Predicted = as.vector(predictions_female), Sex = "Female"),
  data.frame(Observed = data_male$test$Rings, Predicted = as.vector(predictions_male), Sex = "Male")
)

# Set factor levels for correct ordering
plot_data$Sex <- factor(plot_data$Sex, levels = c("Infant", "Female", "Male"))

#  Visualization
ggplot(plot_data, aes(x = Observed, y = Predicted)) +
  # Add points with transparency
