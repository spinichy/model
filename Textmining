# 2. Function to fetch all replies for a specific top-level comment thread
get_all_replies <- function(parent_id) {
  replies_df <- data.frame()
  next_page_token <- NULL
  
  repeat {
    page_param <- ifelse(is.null(next_page_token), "", paste0("&pageToken=", next_page_token))
    # Fetch snippet part to get publishedAt and likeCount
    url <- paste0("https://www.googleapis.com/youtube/v3/comments?",
                  "key=", my_api_key,
                  "&part=snippet",
                  "&parentId=", parent_id,
                  "&maxResults=100",
                  page_param)
    
    data <- fromJSON(url)
    if (!is.null(data$items)) {
      # Extract text, published date, and like count
      snippet <- data$items$snippet
      temp_df <- data.frame(
        text = snippet$textDisplay,
        published_at = snippet$publishedAt,
        like_count = snippet$likeCount,
        stringsAsFactors = FALSE
      )
      replies_df <- rbind(replies_df, temp_df)
    }
    
    next_page_token <- data$nextPageToken
    if (is.null(next_page_token)) break
  }
  return(replies_df)
}

# 3. Main loop: Retrieve top-level threads and their full reply chains
next_page_token <- NULL
repeat {
  page_param <- ifelse(is.null(next_page_token), "", paste0("&pageToken=", next_page_token))
  
  url_threads <- paste0("https://www.googleapis.com/youtube/v3/commentThreads?",
                        "key=", my_api_key,
                        "&videoId=", video_id,
                        "&part=snippet",
                        "&maxResults=100",
                        "&order=time",
                        "&textFormat=plainText",
                        page_param)
  
  data_threads <- fromJSON(url_threads)
  
  if (!is.null(data_threads$items)) {
    # Extract top-level comment info
    top_snippet <- data_threads$items$snippet$topLevelComment$snippet
    top_df <- data.frame(
      text = top_snippet$textDisplay,
      published_at = top_snippet$publishedAt,
      like_count = top_snippet$likeCount,
      stringsAsFactors = FALSE
    )
    all_comments_data <- rbind(all_comments_data, top_df)
    
    # Check if there are replies to fetch
    total_replies <- data_threads$items$snippet$totalReplyCount
    parent_ids <- data_threads$items$id
    
    for (i in 1:length(total_replies)) {
      # Only call the function if there are replies
      if (total_replies[i] > 0) {
        all_comments_data <- rbind(all_comments_data, get_all_replies(parent_ids[i]))
      }
    }
  }
  
  next_page_token <- data_threads$nextPageToken
  if (is.null(next_page_token)) break
}

