# 1. Function to scrape article content
scrape_abc_article <- function(article_url) {
  page <- read_html(article_url)
  title <- page %>% html_node("h1") %>% html_text(trim = TRUE)
  paragraphs <- page %>% html_elements("p.EkqkG") %>% html_text(trim = TRUE)
  full_text <- paste(paragraphs, collapse = "\n\n")
  return(data.frame(url = article_url, title = title, content = full_text, stringsAsFactors = FALSE))
}

