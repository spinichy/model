# 1. Load necessary libraries
library(dplyr)
library(stringr)
library(KoNLP)

# 2. Define the preprocessing function
# The comments inside the function are written in English as requested.
preprocess_text <- function(input_text) {
  # Return an empty string if input is null, NA, or empty
  if (is.null(input_text) || is.na(input_text) || nchar(trimws(input_text)) == 0) {
    return("")
  }
  
  # 1. Remove page number patterns (e.g., "- 1 -") and condense initial whitespace
  text <- str_replace_all(input_text, "-\\s?\\d+\\s?-", " ") 
  text <- str_squish(text) # Initial cleanup of redundant spaces
  
  # 2. Remove special characters and symbols, keeping only Korean, English, numbers, and spaces
  text <- str_replace_all(text, "[^가-힣a-zA-Z0-9\\s]", " ")
  
  # 3. Convert to lowercase and remove all numeric digits
  text <- str_to_lower(text)
  text <- str_remove_all(text, "[0-9]")
  
  # 4. Extract Nouns (Korean morphology analysis)
  words <- extractNoun(text)
  
  # 5. Remove stop words and single-character words
  stop_words_custom <- c("대한", "대통령", "우리", "오늘", "이번", "저", "것", 
                         "취임", "취임사", "취임식", "민국", "여러", "본인", 
                         "니다", "이것", "그것", "있읍니다", "년대", "것입니다",
                         "하겠읍니다", "이", "수", "등", "안", "대통령의", "제대", "문재",
                         "부의장", "것이요", "그동안", "해야겠읍니다", "겠읍니다", "읍니다", 
                         "대다수", "왔읍니다", "일어났읍니다", "가운데", "없읍니다", "대통력",
                         "부의장", "것이요", "그동안", "해야겠읍니다", "겠읍니다", 
                         "읍니다", "대다수", "왔읍니다", "일어났읍니다", "가운데", 
                         "없읍니다", "대통력",  "대통령이승만박사담화집", "다바치",
                         "다먹고", "대다수", "되었읍니다", "국민여러분","무정견")
  words <- words[!words %in% stop_words_custom]
  
  # Filter out words with length 1 or less
  words <- words[nchar(words) > 1] 
  
  # 6. Final cleanup: Join into a string and ensure no double spaces remain
  # str_squish handles multiple spaces, tabs, and newlines effectively
  cleaned_text <- paste(words, collapse = " ")
  return(str_squish(cleaned_text))
}

# 3. Apply the function with progress tracking and time measurement
