# Preprocess function for Korean soccer comments
preprocess_korean <- function(df) {
  
  # Ensure the input is a data frame
  if(!is.data.frame(df)) {
    df <- data.frame(text = df, stringsAsFactors = FALSE)
  }
  
  # Convert to lowercase
  clean_text <- str_to_lower(df$text)
  
  # Remove special characters
  clean_text <- str_replace_all(clean_text, "[^[:alnum:][:space:]가-힣]", "")
  
  # Remove numbers
  clean_text <- str_replace_all(clean_text, "[0-9]+", "")
  
  # Remove extra whitespaces
  clean_text <- str_squish(clean_text)
  
  # Define specific 1-character words that carry strong sentiment in soccer
  # You can expand this list based on your specific dataset
  sentiment_1char <- c("와", "헐", "윽", "굿", "짱", "판", "골", "슛")
  
  # Lemmatization and filtering
  processed_list <- sapply(clean_text, function(x) {
    if(is.na(x) || x == "") return("")
    
    # Morphological analysis
    morphs <- SimplePos09(x)
    
    # Extract nouns, verbs, adjectives, and adverbs
    words <- unlist(str_extract_all(morphs, "[가-힣]+/(N|VV|VA|MAG)"))
    words <- str_replace(words, "/(N|VV|VA|MAG)", "")
    
    # Filter: Keep if 2+ characters OR if it's in the special sentiment list
    words <- words[nchar(words) >= 2 | words %in% sentiment_1char]
    
    # Filter: Remove common stop words
    custom_stopwords <- c("정말", "진짜", "너무", "하다", "그것", "저것", "이거", "저거")
    words <- words[!(words %in% custom_stopwords)]
    
    return(paste(words, collapse = " "))
  })
  
  df$processed_text <- processed_list
  return(df)
}

