custom_stopwords <- c("abc", "news", "story", "said") # User-defined stopwords
corpus <- tm_map(corpus, removeWords, c(stopwords("en"), custom_stopwords))

# 6. Lemmatization (using textstem package or similar logic)
# Note: R's 'tm' usually handles stemming. For true Lemmatization, install 'textstem'
# install.packages("textstem")
corpus <- tm_map(corpus, content_transformer(textstem::lemmatize_strings))

