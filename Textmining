# 3. Comprehensive Preprocessing Pipeline
# Create a corpus from the content
corpus <- Corpus(VectorSource(news_df$content))


# Define transformation functions for the pipeline
# 1. Remove special characters/symbols (replace with space)
toSpace <- content_transformer(function(x, pattern) gsub(pattern, " ", x))
corpus <- tm_map(corpus, toSpace, "[^[:alnum:]]") 

# 2. Expand contractions (simplified example)
corpus <- tm_map(corpus, toSpace, "n't") # Basic example for "don't" -> "do"

# 3. Convert to lowercase
